{
  "name": "aether-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --import tsx server/src/index.ts",
    "dev:client": "vite --config vite.config.ts",
    "build": "tsc --noEmit && node --import tsx scripts/package-source.ts && vite build",
    "start": "node --import tsx server/src/index.ts",
    "test": "vitest run",
    "simulate": "node --import tsx scripts/simulate.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "data:import": "python3 scripts/import-data.py",
    "source:pack": "node --import tsx scripts/package-source.ts",
    "format": "prettier --write client server shared tests scripts/*.ts api *.ts *.json docs/*.md README.md",
    "docs:cards": "node --import tsx scripts/generate-reference.ts"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.1",
    "lucide": "^0.468.0",
    "pg": "^8.13.1",
    "tsx": "^4.23.15",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "fflate": "^0.8.3",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.5"
  }
}
